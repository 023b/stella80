# Copy to .env. Read by docker compose only.

# Where the web UI is published on the host.
#   solo:   127.0.0.1 (only this machine; required, the app refuses anything else in solo mode)
#   shared: your Tailscale IP (recommended), a LAN IP, or 0.0.0.0 for every interface
STELLA80_BIND=127.0.0.1
STELLA80_PORT=8480

# Seconds between vault agent runs
AGENT_INTERVAL=600
